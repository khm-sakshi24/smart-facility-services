# Smart Facility Services - Backend Environment Variables Example
# Duplicate this file to .env or set environment variables in your deployment dashboard.

# Server Port
SERVER_PORT=8080

# PostgreSQL Production Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_facility_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT Authentication Secret (Must be at least 256-bit / 32 characters in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://smartfacilityservices.com
